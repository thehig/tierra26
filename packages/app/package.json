{
  "name": "@tierra26/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "tierra26 rendered web app (React + Vite) — binds the framework-agnostic @tierra26/ui view-models to a live, worker-driven interface",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @demo",
    "walkthrough": "playwright test --grep @demo --headed"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
